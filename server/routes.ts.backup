  <!-- Landing Page / Home -->
  <url>
    <loc>${baseUrl}/</loc>
    <lastmod>2025-10-26</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  
  <!-- Authentication Page -->
